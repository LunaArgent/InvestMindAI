    .budget-number strong {
        display: block;
        font-size: 28px;
        margin-bottom: 8px;
    }

    .budget-number span {
        color: var(--muted);
        font-size: 12px;
    }

    .progress-track {
        height: 9px;
        border-radius: 10px;
        background: #35443A;
        margin: 22px 0 12px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        width: 53.5%;
        border-radius: inherit;
        background: linear-gradient(90deg, #8EA994, #A9BDAA);
    }

    .budget-legend {
        font-size: 10px;
        color: var(--muted);
        flex-wrap: wrap;
    }

        .budget-legend strong {
            color: var(--green);
        }

    .insight {
        display: flex;
        gap: 13px;
        padding: 17px;
        border: 1px solid #3A5143;
        background: #222F27;
        border-radius: 14px;
        margin-top: 27px;
    }

    .insight-icon {
        color: var(--green);
        font-size: 22px;
    }

    .insight strong {
        font-size: 12px;
    }

    .insight p {
        font-size: 11px;
        color: #a9bbca;
        line-height: 1.6;
        margin: 7px 0 0;
    }

    footer {
        margin-top: 28px;
        color: var(--muted);
        font-size: 10px;
        flex-wrap: wrap;
    }

        footer span:first-child {
            color: #D8D2C5;
            font-weight: 700;
        }

    @@media (max-width: 800px) {
        .welcome {
            align-items: flex-start;
            flex-direction: column;
            margin-top: 38px;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .budget {
            grid-column: auto;
        }

        .allocation-content {
            flex-direction: column;
            align-items: stretch;
        }

        .expense-fields {
            grid-template-columns: 1fr 1fr;
        }

        .expense-description {
            grid-column: 1 / -1;
        }

        .add-expense-button {
            min-height: 40px;
        }

        .donut-chart {
            align-self: center;
        }

        .date-card {
            width: 100%;
            box-sizing: border-box;
        }

        .profile {
            font-size: 0;
            gap: 0;
            padding: 12px;
        }

            .profile .status-dot {
                width: 9px;
                height: 9px;
            }
    }
</style>



@code {
    private static readonly CultureInfo PolishCulture = CultureInfo.GetCultureInfo("pl-PL");

    private decimal _stocksValue = 5200m;
    private decimal _etfValue = 4950m;
    private decimal _cashValue = 2500m;
    private decimal _otherAssetsValue = 12830m;
    private decimal _monthlyBudget = 4000m;

    private decimal StocksValue
    {
        get => _stocksValue;
        set => _stocksValue = Math.Max(0, value);
    }

    private decimal EtfValue
    {
        get => _etfValue;
        set => _etfValue = Math.Max(0, value);
    }

    private decimal CashValue
    {
        get => _cashValue;
        set => _cashValue = Math.Max(0, value);
    }

    private decimal OtherAssetsValue
    {
        get => _otherAssetsValue;
        set => _otherAssetsValue = Math.Max(0, value);
    }

    private decimal MonthlyBudget
    {
        get => _monthlyBudget;
        set => _monthlyBudget = Math.Max(0, value);
    }

    private string NewExpenseDescription { get; set; } = string.Empty;
    private decimal NewExpenseAmount { get; set; }
    private string ExpenseError { get; set; } = string.Empty;

    private List<ExpenseItem> Expenses { get; } = new()
    {
        new ExpenseItem(1, "Czynsz i rachunki", 1200m),
        new ExpenseItem(2, "Zakupy spożywcze", 540m),
        new ExpenseItem(3, "Transport", 180m),
        new ExpenseItem(4, "Subskrypcje", 220m)
    };

    private decimal PortfolioTotal => StocksValue + EtfValue + CashValue;
    private decimal TotalWealth => PortfolioTotal + OtherAssetsValue;
    private decimal TotalExpenses => Expenses.Sum(expense => expense.Amount);
    private decimal BudgetRemaining => MonthlyBudget - TotalExpenses;
    private decimal BudgetProgress => MonthlyBudget <= 0
        ? 0
        : Math.Clamp(TotalExpenses / MonthlyBudget * 100m, 0m, 100m);

    private decimal StocksShare => PortfolioTotal <= 0 ? 0 : StocksValue / PortfolioTotal * 100m;
    private decimal EtfShare => PortfolioTotal <= 0 ? 0 : EtfValue / PortfolioTotal * 100m;
    private decimal CashShare => PortfolioTotal <= 0 ? 0 : CashValue / PortfolioTotal * 100m;

    private string BudgetProgressStyle =>
        $"width: {BudgetProgress.ToString("0.0", CultureInfo.InvariantCulture)}%;";

    private string AllocationChartStyle
    {
        get
        {
            if (PortfolioTotal <= 0)
            {
                return "background: #35443A;";
            }

            var stocksEnd = StocksShare;
            var etfEnd = StocksShare + EtfShare;

            return $"background: conic-gradient(#8EA994 0% {stocksEnd.ToString("0.####", CultureInfo.InvariantCulture)}%, #C5AD7B {stocksEnd.ToString("0.####", CultureInfo.InvariantCulture)}% {etfEnd.ToString("0.####", CultureInfo.InvariantCulture)}%, #7C8995 {etfEnd.ToString("0.####", CultureInfo.InvariantCulture)}% 100%);";
        }
    }

    private string AllocationDescription =>
        $"Struktura portfela: akcje {FormatPercent(StocksShare)}, ETF-y {FormatPercent(EtfShare)}, gotówka {FormatPercent(CashShare)}.";

    private static string FormatMoney(decimal value) =>
        value.ToString("N2", PolishCulture) + " zł";

    private static string FormatPercent(decimal value) =>
        value.ToString("0.0", PolishCulture) + "%";

    private void AddExpense()
    {
        ExpenseError = string.Empty;

        if (string.IsNullOrWhiteSpace(NewExpenseDescription))
        {
            ExpenseError = "Wpisz opis wydatku.";
            return;
        }

        if (NewExpenseAmount <= 0)
        {
            ExpenseError = "Kwota wydatku musi być większa od zera.";
            return;
        }

        var nextId = Expenses.Count == 0 ? 1 : Expenses.Max(expense => expense.Id) + 1;
        Expenses.Add(new ExpenseItem(nextId, NewExpenseDescription.Trim(), NewExpenseAmount));

        NewExpenseDescription = string.Empty;
        NewExpenseAmount = 0;
    }

    private void RemoveExpense(int id)
    {
        var expense = Expenses.FirstOrDefault(item => item.Id == id);
        if (expense is not null)
        {
            Expenses.Remove(expense);
        }
    }

    private sealed record ExpenseItem(int Id, string Description, decimal Amount);
}
