    .legend-label {
        gap: 9px;
        color: var(--text);
        font-size: 12px;
    }

    .legend-dot {
        width: 9px;
        height: 9px;
        flex: 0 0 9px;
        border-radius: 50%;
    }

    .stocks-dot {
        background: #8EA994;
    }

    .etf-dot {
        background: #C5AD7B;
    }

    .cash-dot {
