@page "/"
@using System.Globalization

<PageTitle>InvestMind AI | Panel inwestora</PageTitle>

<div class="dashboard">
    <header class="topbar">
        <div class="brand">
            <div class="brand-icon">IM</div>
            <div>
                <h1>InvestMind <span>AI</span></h1>
                <p>YOUR FINANCIAL INTELLIGENCE</p>
            </div>
        </div>
        <div class="profile">
            <span class="status-dot"></span>
            Tryb demonstracyjny
        </div>
    </header>

    <section class="welcome">
        <div>
            <p class="eyebrow">TWÓJ CENTRUM DOWODZENIA</p>
            <h2>Witaj w swoim świecie finansów.</h2>
            <p>Śledź swoje cele, kontroluj budżet i rozwijaj wiedzę inwestycyjną.</p>
        </div>
        <div class="date-card">
            <span>TWÓJ PLAN</span>
            <strong>Buduj przyszłość</strong>
            <small>Jeden krok na raz.</small>
        </div>
    </section>

    <section class="stats">
        <article class="stat-card">
            <p>Całkowity majątek</p>
            <h3>@FormatMoney(TotalWealth)</h3>
            <span class="muted">Przykładowe dane</span>
        </article>
        <article class="stat-card">
            <p>Portfel inwestycyjny</p>
            <h3>@FormatMoney(PortfolioTotal)</h3>
            <span class="muted">Wartość na podstawie wpisanych kwot</span>
        </article>
        <article class="stat-card">
            <p>Wydatki w tym miesiącu</p>
            <h3>@FormatMoney(TotalExpenses)</h3>
            <span class="muted">Przykładowe dane</span>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel portfolio">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">INWESTYCJE</p>
                    <h3>Twój portfel</h3>
                </div>
                <span class="tag">DEMO</span>
            </div>

            <div class="portfolio-total">
                <span>Wartość portfela</span>
                <strong>@FormatMoney(PortfolioTotal)</strong>
                <span class="muted">Suma aktualnych pozycji</span>
            </div>

            <div class="asset-row">
                <div class="asset-icon stock">S</div>
                <div class="asset-name">
                    <strong>Akcje</strong>
                    <small>Przykładowa pozycja</small>
                </div>
                <input class="amount-input" aria-label="Wartość akcji" type="number" min="0" step="0.01" @bind="StocksValue" />
            </div>
            <div class="asset-row">
                <div class="asset-icon etf">E</div>
                <div class="asset-name">
                    <strong>ETF-y</strong>
                    <small>Przykładowa pozycja</small>
                </div>
                <input class="amount-input" aria-label="Wartość ETF-ów" type="number" min="0" step="0.01" @bind="EtfValue" />
            </div>
            <div class="asset-row">
                <div class="asset-icon cash">Z</div>
                <div class="asset-name">
                    <strong>Gotówka</strong>
                    <small>Środki niezaangażowane</small>
                </div>
                <input class="amount-input" aria-label="Wartość gotówki" type="number" min="0" step="0.01" @bind="CashValue" />
            </div>
            <div class="other-assets-editor">
                <label for="otherAssets">Pozostałe środki poza portfelem</label>
                <input id="otherAssets" class="amount-input" type="number" min="0" step="0.01" @bind="OtherAssetsValue" />
            </div>
        </article>

        <article class="panel allocation-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">STRUKTURA AKTYWÓW</p>
                    <h3>Alokacja portfela</h3>
                </div>
                <span class="tag">DEMO</span>
            </div>

            <div class="allocation-content">
                <div class="donut-chart" role="img"
                     aria-label="@AllocationDescription"
                     style="@AllocationChartStyle">
                    <div class="donut-center">
                        <span>WARTOŚĆ PORTFELA</span>
                        <strong>@FormatMoney(PortfolioTotal)</strong>
                    </div>
                </div>

                <div class="allocation-legend">
                    <div class="legend-item">
                        <span class="legend-label">
                            <span class="legend-dot stocks-dot"></span>
                            Akcje
                        </span>
                        <span class="legend-value">
                            <strong>@FormatMoney(StocksValue)</strong>
                            <small>@FormatPercent(StocksShare)</small>
                        </span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-label">
                            <span class="legend-dot etf-dot"></span>
                            ETF-y
                        </span>
                        <span class="legend-value">
                            <strong>@FormatMoney(EtfValue)</strong>
                            <small>@FormatPercent(EtfShare)</small>
                        </span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-label">
                            <span class="legend-dot cash-dot"></span>
                            Gotówka
                        </span>
                        <span class="legend-value">
                            <strong>@FormatMoney(CashValue)</strong>
                            <small>@FormatPercent(CashShare)</small>
                        </span>
                    </div>
                </div>
            </div>

            <p class="allocation-note">Udziały i wykres są przeliczane automatycznie na podstawie wartości wpisanych w portfelu.</p>
        </article>

        <article class="panel budget">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">FINANSE OSOBISTE</p>
                    <h3>Budżet miesięczny</h3>
                </div>
                <span class="tag">DEMO</span>
            </div>

            <div class="budget-number">
                <strong>@FormatMoney(TotalExpenses)</strong>
                <span>z <input class="budget-input" aria-label="Planowany budżet miesięczny" type="number" min="0" step="0.01" @bind="MonthlyBudget" /> zaplanowanych wydatków</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="@BudgetProgressStyle"></div>
            </div>
            <div class="budget-legend">
                <span>Wykorzystano @FormatPercent(BudgetProgress)</span>
                <strong>@FormatMoney(BudgetRemaining) pozostało</strong>
            </div>

            <div class="expense-entry">
                <h4>Dodaj wydatek</h4>
                <div class="expense-fields">
                    <input class="expense-description" aria-label="Opis wydatku" placeholder="Np. Zakupy spożywcze" @bind="NewExpenseDescription" />
                    <input class="expense-amount" aria-label="Kwota wydatku" type="number" min="0.01" step="0.01" placeholder="Kwota" @bind="NewExpenseAmount" />
                    <button type="button" class="add-expense-button" @onclick="AddExpense">Dodaj</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(ExpenseError))
                {
                    <p class="validation-message">@ExpenseError</p>
                }
            </div>

            <div class="expense-list">
                <h4>Wydatki w tym miesiącu</h4>
                @foreach (var expense in Expenses)
                {
                    <div class="expense-row" @key="expense.Id">
                        <span>@expense.Description</span>
                        <strong>@FormatMoney(expense.Amount)</strong>
                        <button type="button" class="remove-expense-button" title="Usuń wydatek" aria-label="Usuń wydatek: @expense.Description" @onclick="() => RemoveExpense(expense.Id)">Usuń</button>
                    </div>
                }
                @if (Expenses.Count == 0)
                {
                    <p class="empty-expenses">Nie dodano jeszcze żadnych wydatków.</p>
                }
            </div>

            <div class="insight">
                <span class="insight-icon">✦</span>
                <div>
                    <strong>Mały krok, duży cel</strong>
                    <p>Regularne monitorowanie wydatków pomaga lepiej planować oszczędności.</p>
                </div>
            </div>
        </article>
    </section>

    <footer>
        <span>InvestMind AI</span>
        <span>Dane demonstracyjne · To nie są notowania na żywo ani porada inwestycyjna.</span>
    </footer>
</div>

<style>

