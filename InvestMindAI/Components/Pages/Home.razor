        font-size: 12px;
    }

    .panel {
        padding: 24px;
        min-width: 0;
    }

    .panel-heading {
        margin-bottom: 24px;
    }

        .panel-heading h3 {
            font-size: 19px;
            margin: 8px 0 0;
        }

    .tag {
        font-size: 9px;
        color: var(--green);
        letter-spacing: 1px;
        border: 1px solid #2c5b53;
